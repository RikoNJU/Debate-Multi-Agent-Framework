DEBATE_HOST=0.0.0.0
DEBATE_PORT=8020
DEBATE_CORS_ORIGINS=http://localhost:3001,http://localhost:5174
DEBATE_DATA_DIR=backend/data
# Leave empty to use SQLite at DEBATE_DATA_DIR/debate.db.
DEBATE_DATABASE_URL=

# Teacher/admin portal. Remove the bootstrap password after the first account is created.
DEBATE_BOOTSTRAP_ADMIN_USERNAME=
DEBATE_BOOTSTRAP_ADMIN_PASSWORD=
DEBATE_BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
DEBATE_PORTAL_SESSION_HOURS=12

DEBATE_PROVIDER=openai_compatible
DEBATE_MODEL=deepseek-ai/DeepSeek-V4-Pro
DEBATE_BASE_URL=https://api.siliconflow.cn/v1
DEBATE_API_KEY=
DEBATE_TEMPERATURE=0.2
DEBATE_TIMEOUT_SECONDS=120
DEBATE_MAX_RETRIES=2
DEBATE_SPECIALIST_CONCURRENCY=1
DEBATE_REVIEW_ATTEMPTS=3
DEBATE_SPECIALIST_MAX_TOKENS=4096
DEBATE_THINKING_BUDGET=1024
DEBATE_RETRY_BASE_SECONDS=1
DEBATE_RETRY_MAX_SECONDS=8

DEBATE_MINERU_API_BASE=https://mineru.net/api/v4
DEBATE_MINERU_TOKEN=
DEBATE_MINERU_MODEL_VERSION=vlm
DEBATE_MINERU_IS_OCR=true
DEBATE_MINERU_ENABLE_TABLE=true
DEBATE_MINERU_ENABLE_FORMULA=true
DEBATE_MINERU_LANGUAGE=ch
DEBATE_MINERU_TIMEOUT_SECONDS=600
DEBATE_MINERU_POLL_INTERVAL_SECONDS=5
DEBATE_MINERU_MAX_PDF_BYTES=52428800
DEBATE_MINERU_OUTPUT_DIR=backend/src/debate_agent_framework/data/mineru

# Standalone AIGC screening. It never participates in review scoring.
DEBATE_AIGC_ENABLED=false
DEBATE_AIGC_MODEL_ID=yuchuantian/AIGC_detector_zhv3
DEBATE_AIGC_MODEL_REVISION=
DEBATE_AIGC_DEVICE=auto
DEBATE_AIGC_BATCH_SIZE=8
DEBATE_AIGC_AI_LABEL_INDEX=1
DEBATE_AIGC_LOCAL_FILES_ONLY=false
DEBATE_AIGC_MEDIUM_THRESHOLD=0.5
DEBATE_AIGC_HIGH_THRESHOLD=0.8
DEBATE_AIGC_MAX_CONCURRENCY=1

# Set the old repository root to reuse its runtime Chroma database directly.
PAPER_REVIEW_BACKEND_ROOT=
# Or set the Chroma directory explicitly. An explicit path takes precedence.
DEBATE_RAG_CHROMA_PATH=
DEBATE_RAG_COLLECTIONS=user_result_content_collection_cloud_4b,user_result_format_collection_cloud_4b
DEBATE_EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
DEBATE_EMBEDDING_MODEL=text-embedding-v4
DEBATE_EMBEDDING_API_KEY=
DEBATE_EMBEDDING_DIMENSIONS=2048
DEBATE_EMBEDDING_TIMEOUT_SECONDS=60

# 外部学术证据检索（OpenAlex，免费无需 API Key；none 关闭）
DEBATE_EVIDENCE_PROVIDER=openalex
DEBATE_EVIDENCE_MAILTO=
DEBATE_EVIDENCE_MAX_RESULTS=5
DEBATE_EVIDENCE_TIMEOUT_SECONDS=20

# 历史评分校准 RAG（与历史建议共用同一 Chroma 目录）
DEBATE_RAG_SCORE_COLLECTION=paper_review_score_cases

# V2 清洗后向量库 RAG（Clean Dense V2 + BM25 V2 + RRF + Reranker）
# 仅当以下三个路径都配置时才启用 V2 RAG。
DEBATE_V2_MODE=off
RAG_V2_CORPUS_PATH=
DEBATE_V2_CHROMA_PATH=
DEBATE_V2_BM25_PATH=
DEBATE_V2_API_KEY=
# 构建脚本读取的旧库位置和真实 collection：
LEGACY_CHROMA_PATH=
LEGACY_CONTENT_COLLECTION=user_result_content_collection_cloud_4b
LEGACY_FORMAT_COLLECTION=user_result_format_collection_cloud_4b
# 以下 V2 配置有默认值：
# DEBATE_V2_EMBEDDING_ENDPOINT=https://api.siliconflow.cn/v1/embeddings
# DEBATE_V2_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# DEBATE_V2_EMBEDDING_DIMENSIONS=4096
# DEBATE_V2_RERANK_ENDPOINT=https://api.siliconflow.cn/v1/rerank
# DEBATE_V2_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# DEBATE_V2_RERANK_THRESHOLD=6
# DEBATE_V2_RETRIEVAL_CONCURRENCY=2
# DEBATE_V2_TIMEOUT_SECONDS=120
